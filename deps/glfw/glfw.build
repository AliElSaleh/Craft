Assembly     glfw
Version      3.1.2
Type:shared  shared_library
Type:!shared static_library

Compiler.Flags $SharedCompilerFlags
Linker.Flags   $SharedLinkerFlags

SourceDirectory       src

if release
{
    BuildDirectory        Build/Release/%%Shared
    IntermediateDirectory Intermediate/Release/%%Shared
}
else
{
    BuildDirectory        Build/Debug/%%Shared
    IntermediateDirectory Intermediate/Debug/%%Shared
}

SourceFiles
[
    context.c init.c input.c monitor.c window.c
]

Compiler.Includes        . include deps
Compiler.Includes.Export include

if client_library == opengl Compiler.Defines _GLFW_USE_OPENGL
if client_library == glesv1 Compiler.Defines _GLFW_USE_GLESV1
if client_library == glesv2 Compiler.Defines _GLFW_USE_GLESV2

Compiler.Defines _CRT_SECURE_NO_WARNINGS _GLFW_VERSION_FULL="$Version"

if windows
{
    "Using Win32 for window creation"
    Compiler.Defines _GLFW_WIN32
    if shared         Compiler.Defines _GLFW_BUILD_DLL
    if no_dload_winmm Compiler.Defines _GLFW_NO_DLOAD_WINMM

    SourceFiles win32_*.c winmm_*.c

    if egl
    {
        SourceFiles egl_*.c
        Compiler.Defines _GLFW_EGL
    }
    else
    {
        SourceFiles wgl_*.c
        Compiler.Defines _GLFW_WGL
    }

    Win32Libraries kernel32 user32 opengl32 shell32 gdi32

    Libraries:shared $Win32Libraries
    Libraries.Export:!shared $Win32Libraries
}

if linux
{
    "Using X11 for window creation"
    Compiler.Defines _GLFW_X11

    SourceFiles x11_*.c linux_*.c posix_*.c xkb_*.c

    Libraries.Export:!shared X11 Xrandr Xcursor Xinerama Xi m GL

    if egl
    {
        SourceFiles egl_*.c
        Compiler.Defines _GLFW_EGL
    }
    else
    {
        SourceFiles glx_*.c
        Compiler.Defines _GLFW_GLX _GLFW_HAS_GLXGETPROCADDRESS
    }
}

if apple
{
    "Using NSGL"
    "Using Cocoa for window creation"
    Compiler.Defines _GLFW_COCOA _GLFW_NSGL

    SourceFiles *.m cocoa_*.c nsgl_*.c mach_time.c posix_tls.c

    Compiler.Defines GL_SILENCE_DEPRECATION

    if menubar Compiler.Defines _GLFW_USE_MENUBAR
    if chdir   Compiler.Defines _GLFW_USE_CHDIR

    if !shared Apple.Frameworks.Export
    [
        Cocoa
        Foundation
        QuartzCore
        AppKit
        IOKit
        OpenGL
    ]

    if !shared Linker.Flags.Export -ObjC

    if clang
    {
        SharedCompilerFlags -fno-common
    }
}

if msvc
{
    if release
    {
        SharedCompilerFlags         /EHa
        SharedCompilerFlags:shared  /MD
        SharedCompilerFlags:!shared /MT
    }
    else
    {
        SharedLinkerFlags /DEBUG

        SharedCompilerFlags         /EHa /Z7
        SharedCompilerFlags:shared  /MDd
        SharedCompilerFlags:!shared /MTd
    }
}

if clang|gcc
{
    if release
    {
        SharedCompilerFlags -O3
    }
    else
    {
        SharedCompilerFlags -O0 -g
    }
}

# TODO _GLFW_HAS_GLXGETPROCADDRESSARB
# TODO _GLFW_HAS_GLXGETPROCADDRESSEXT
# TODO _GLFW_HAS_DLOPEN

option.compiler(gcc msvc)
option.client_library(opengl glesv1 glesv2)
option.release
option.shared
option.egl
option.no_dload_winmm

if apple
{
    option.chdir
    option.menubar
}
