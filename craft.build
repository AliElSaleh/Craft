option.compiler(gcc msvc)

Assembly CraftGame
.run

if compiler == gcc  Compiler gcc
if compiler == msvc Compiler cl

if cl  Compiler.Flags /O2
if gcc Compiler.Flags -std=c99 -O3

SourceFiles
[
    src/auth.c
    src/client.c
    src/cube.c
    src/db.c
    src/item.c
    src/main.c
    src/map.c
    src/matrix.c
    src/ring.c
    src/sign.c
    src/util.c
    src/world.c
    deps/glew/src/glew.c
    deps/lodepng/lodepng.c
    deps/noise/noise.c
    deps/sqlite/sqlite3.c
    deps/tinycthread/tinycthread.c
]

Compiler.Includes
[
    deps/glew/include
    deps/glfw
    deps/glfw/include
    deps/glfw/deps
    deps/lodepng
    deps/noise
    deps/sqlite
    deps/tinycthread
    deps/curl/include
]

if windows
{
    Library.Paths deps/curl/lib
    Libraries     kernel32 opengl32 user32 shell32 gdi32 ws2_32 libcurl
    Compiler.Defines _WIN32 _WINSOCK_DEPRECATED_NO_WARNINGS
}

if !windows Libraries   curl dl

Compiler.Defines _CRT_SECURE_NO_WARNINGS CURL_STATICLIB GLEW_STATIC

Depends deps/glfw | release compiler=%compiler

postbuild.copy textures/ $BuildDirectory
postbuild.copy shaders/ $BuildDirectory
